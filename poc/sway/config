# kiosk-lite phase 1 proof.
# Loaded only by poc/bin/session.sh. This file is the whole compositor config.

set $mod Mod4

xwayland disable

default_border none
default_floating_border none
gaps inner 0
gaps outer 0
focus_follows_mouse no
mouse_warping none

output * bg "#000000" solid
seat * hide_cursor 3000

for_window [app_id="^chromium"] floating enable, border none
for_window [app_id="^chrome-"] floating enable, border none

bindsym $mod+Shift+e exit

# session.sh appends: exec sh <poc>/bin/launch.sh
